# ============================================================
# CareOS — Environment Variables Template
# ============================================================
# Copy this file to .env.local for local development.
# NEVER commit .env.local or any file with real credentials.
#
# For Netlify deployment: Site Settings → Environment Variables
# ============================================================

# ═══════════════════════════════════════════════════════════
# SUPABASE (Required) — Database & Authentication
# ═══════════════════════════════════════════════════════════
# Get from: Supabase Dashboard → Settings → API
# https://app.supabase.com

# Your Supabase project URL (safe to expose to the browser — enforced by RLS)
VITE_SUPABASE_URL=

# Your Supabase anon/public key (safe to expose to the browser)
VITE_SUPABASE_ANON_KEY=

# ═══════════════════════════════════════════════════════════
# RESEND (Required for transactional email)
# ═══════════════════════════════════════════════════════════
# Server-side only — NEVER prefix with VITE_ or expose to the browser.
# Get from: https://resend.com → API Keys
#
# IMPORTANT: Before emails will send in production:
#   1. Create a Resend account at https://resend.com
#   2. Add and verify your sending domain (e.g. careoshealth.com)
#      in Resend → Domains → Add Domain
#   3. Configure the DNS records Resend provides (SPF, DKIM, DMARC)
#   4. Create an API key in Resend → API Keys → Create API Key
#   5. Set RESEND_FROM_EMAIL to match your verified domain
#      e.g. "CareOS <no-reply@careoshealth.com>"
#
# NOTE: Do NOT add RESEND_API_KEY to .env.local — it's only needed
# by Netlify Functions (server-side). Add it in Netlify dashboard.

RESEND_API_KEY=
RESEND_FROM_EMAIL=CareOS <no-reply@careoshealth.com>

# ═══════════════════════════════════════════════════════════
# APPLICATION URL (Required for email links)
# ═══════════════════════════════════════════════════════════
# The production URL of your deployed application.
# Used to build confirmation and reset links in emails.
# In Netlify, this is automatically available as URL, but we use APP_URL
# for explicit control.

APP_URL=https://careoshealth.netlify.app

# Optional: for local Netlify Functions testing
# APP_URL=http://localhost:8888

# ═══════════════════════════════════════════════════════════
# DO NOT ADD SERVER-SIDE SECRETS WITH VITE_ PREFIX
# ═══════════════════════════════════════════════════════════
# VITE_ prefixed variables are bundled into the client-side JS
# and visible in browser DevTools.
# Never put RESEND_API_KEY, Supabase service_role key, database
# passwords, or any other server-only secret with a VITE_ prefix.
