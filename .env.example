# ============================================================
# CareOS — Environment Variables Template
# ============================================================
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local or any file with real credentials.
#
# Get Supabase credentials from:
#   Dashboard → Settings → API
#   https://app.supabase.com
# ============================================================

# ── Supabase (Required) ──────────────────────────────────────
# Your Supabase project URL (safe to expose to client)
VITE_SUPABASE_URL=

# Your Supabase anon/public key (safe to expose to client —
# Row-Level Security policies enforce data isolation)
VITE_SUPABASE_ANON_KEY=

# ── Optional: App configuration ──────────────────────────────
# Set to "true" to enable demo mode banner in production
# VITE_DEMO_MODE=true

# ── DO NOT ADD server-side secrets here ──────────────────────
# This file is bundled into the client-side JS. Any value with
# VITE_ prefix will be visible in the browser DevTools.
# Never put Supabase service_role key, database passwords,
# or any other server-only secrets here.
